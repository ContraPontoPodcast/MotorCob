[Unit]
Description=Asterisk do MotorCX (telefonia do agente de voz)
After=docker.service network-online.target 
Requires=docker.service
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/bin/motorcx-voz-segredos
ExecStartPre=-/usr/local/bin/motorcx-voz-config --so-buscar
ExecStartPre=-/usr/bin/docker rm -f motorcx-asterisk
ExecStart=/usr/local/bin/motorcx-voz-rodar asterisk
ExecStop=/usr/bin/docker stop -t 30 motorcx-asterisk
Restart=always
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
