[Unit]
Description=Orquestrador ARI do MotorCX (empresas em modo real)
After=docker.service network-online.target motorcx-asterisk.service
Requires=docker.service
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/bin/motorcx-voz-segredos
ExecStartPre=-/usr/bin/docker rm -f motorcx-voz-real
ExecStart=/usr/local/bin/motorcx-voz-rodar orquestrador
ExecStop=/usr/bin/docker stop -t 30 motorcx-voz-real
Restart=always
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
