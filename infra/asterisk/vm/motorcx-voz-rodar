#!/bin/bash
# Sobe um dos contêineres da voz em primeiro plano (o systemd cuida de reiniciar).
#   motorcx-voz-rodar asterisk | orquestrador | simulado | transcricao | speech | speech-noite | speech-temas |
#                     speech-buscas | simulador-fluxo | importador | fluxo-noite | gerar-fluxo | gerar-segmentacao | sons |
#                     firewall | teste
# sons (PR10): gera sem-robo.wav e alo.wav com o TTS da voz do agente (voz/sons_sistema.py) em /var/motorcx/sons; quem
# instala no Asterisk é o motorcx-voz-sons. Com /var/motorcx/sons/sem-robo.wav, o Asterisk sobe com a pasta montada em
# /var/lib/asterisk/sounds/motorcx (só leitura): os sons ficam depois de reiniciar e de atualizar a imagem.
# teste (SQL 114, "Testar a rota" da tela Telefonia): contínuo nas duas VMs; pega o pedido do banco ("for update skip
# locked"), liga pelo tronco pedido com o app ARI motorcx-teste e grava cada passo. O número de teste fica só na memória.
# fluxo-noite (métricas do Fluxo do agente, SQL 66): só códigos e contagens, sem IA; roda sempre.
# gerar-fluxo (pedido em texto "Descrever e o MotorCX monta", SQL 58/66: voz/gerar_fluxo.py) só roda com o metadado
# motorcx-gerar-fluxo=1 (padrão: desligado); a chave do LLM vem do cofre (motorcx-voz-llm-fluxo).
# gerar-segmentacao ("Descrever segmentos e régua", SQL 79: voz/gerar_segmentacao.py) só roda com o metadado
# motorcx-gerar-segmentacao=1 (padrão: desligado); mesma chave do LLM (motorcx-voz-llm-fluxo).
# speech, speech-noite, speech-temas e speech-buscas (Speech Analytics, SQL 62/63) só rodam com o metadado motorcx-speech-analytics=1
# (padrão: desligado).
# importador (gravações do discador do cliente, SQL 64) só roda com o metadado motorcx-importador-gravacoes=1 (padrão:
# desligado); no banco, cada fonte ainda tem a leitura automática desligada por padrão.
set -euo pipefail
. /usr/local/bin/motorcx-voz-comum
comum_voz=(--rm --network host --user 10010:10010 --env-file "$RUN/voz.env" -e MOTORCX_ARI_SENHA_ARQUIVO="$RUN/ari_senha"
           -v "$RUN:$RUN:ro" -v /var/motorcx:/var/motorcx -v /etc/motorcx:/etc/motorcx:ro --read-only --tmpfs /tmp)
case "${1:-}" in
  asterisk)
    sons=(); [ -f /var/motorcx/sons/sem-robo.wav ] && sons=(-v /var/motorcx/sons:/var/lib/asterisk/sounds/motorcx:ro)
    exec docker run --rm --name motorcx-asterisk --network host \
      -e MOTORCX_GCP_PROJETO="$PROJETO" -e MOTORCX_IP_EXTERNO="$IP_EXTERNO" -e MOTORCX_REDE_LOCAL="$REDE_LOCAL" \
      -v "$RUN:$RUN:ro" -v /var/motorcx/gravacoes:/var/spool/asterisk/motorcx "${sons[@]}" "$IMG_ASTERISK" ;;
  sons)
    exec docker run --name motorcx-voz-sons "${comum_voz[@]}" "$IMG_VOZ" python3 -m voz.sons_sistema --saida /var/motorcx/sons ;;
  orquestrador|simulado)
    modo=real; [ "$1" = simulado ] && modo=simulado
    exec docker run --name "motorcx-voz-$modo" "${comum_voz[@]}" "$IMG_VOZ" \
      python3 -m voz.orquestrador.principal --auto --modo "$modo" --parte "$PARTE" \
      --dados "$RUN/voz.json" --eventos "/var/motorcx/eventos/$modo" ;;
  transcricao)
    reserva=(); [ "$(meta motorcx-transcricao-reserva)" = 1 ] && reserva=(--reserva-api)
    exec docker run --name motorcx-voz-transcricao "${comum_voz[@]}" -e MOTORCX_WHISPER_PASTA=/var/motorcx/modelos -e HF_HOME=/var/motorcx/modelos \
      "$IMG_VOZ" python3 -m voz.transcricao.worker --dados "$RUN/voz.json" --entrada /var/motorcx/importadas \
      --saida /var/motorcx/transcricoes --registrar "${reserva[@]}" ;;
  importador)
    if [ "$(meta motorcx-importador-gravacoes)" != 1 ]; then
      echo "Importador de gravações desligado nesta VM (metadado motorcx-importador-gravacoes)"; exit 0
    fi
    exec docker run --name motorcx-voz-importador "${comum_voz[@]}" -e MOTORCX_IMPORTADOR_GRAVACOES=1 "$IMG_VOZ" \
      python3 -m voz.importador.rotina --parte "$PARTE" --saida /var/motorcx/importadas ;;
  speech|speech-noite|speech-temas|speech-buscas)
    if [ "$(meta motorcx-speech-analytics)" != 1 ]; then
      echo "Speech Analytics desligado nesta VM (metadado motorcx-speech-analytics)"; exit 0
    fi
    if [ "$1" = speech ]; then
      exec docker run --name motorcx-voz-speech "${comum_voz[@]}" -e MOTORCX_SPEECH_ANALYTICS=1 "$IMG_VOZ" \
        python3 -m voz.analise.rotina analisar --pasta /var/motorcx/transcricoes --provedores /etc/motorcx/provedores.json
    fi
    if [ "$1" = speech-buscas ]; then
      exec docker run --name motorcx-voz-speech-buscas "${comum_voz[@]}" -e MOTORCX_SPEECH_ANALYTICS=1 "$IMG_VOZ" \
        python3 -m voz.analise.rotina buscas --parte "$PARTE" --intervalo 2
    fi
    if [ "$1" = speech-temas ]; then
      exec docker run --name motorcx-voz-speech-temas "${comum_voz[@]}" -e MOTORCX_SPEECH_ANALYTICS=1 "$IMG_VOZ" \
        python3 -m voz.analise.rotina temas --parte "$PARTE" --provedores /etc/motorcx/provedores.json
    fi
    exec docker run --name motorcx-voz-speech-noite "${comum_voz[@]}" -e MOTORCX_SPEECH_ANALYTICS=1 "$IMG_VOZ" \
      python3 -m voz.analise.rotina noite --parte "$PARTE" ;;
  firewall)
    # SQL 104: regras motorcx-voz-sip/rtp = lista fixa do criar_gcp.sh + IPs liberados pela equipe no banco. Desligado
    # por padrão: liga com o metadado motorcx-firewall-automatico=1 (bash criar_gcp.sh firewall-automatico)
    if [ "$(meta motorcx-firewall-automatico)" != 1 ]; then
      echo "Firewall automático desligado nesta VM (metadado motorcx-firewall-automatico)"; exit 0
    fi
    exec docker run --name motorcx-voz-firewall "${comum_voz[@]}" -e MOTORCX_IP_EXTERNO="$IP_EXTERNO" \
      -e MOTORCX_REDE_LOCAL="$REDE_LOCAL" -e MOTORCX_FIREWALL_FIXOS="$(meta motorcx-firewall-fixos)" \
      -e MOTORCX_VM_NOME="$(hostname -s)" "$IMG_VOZ" python3 -m voz.firewall ;;
  teste)
    exec docker run --name motorcx-voz-teste "${comum_voz[@]}" -e MOTORCX_IP_EXTERNO="$IP_EXTERNO" \
      -e MOTORCX_REDE_LOCAL="$REDE_LOCAL" -e MOTORCX_VM_NOME="$(hostname -s)" "$IMG_VOZ" \
      python3 -m voz.testador --dados "$RUN/voz.json" ;;
  fluxo-noite)
    exec docker run --name motorcx-voz-fluxo-noite "${comum_voz[@]}" "$IMG_VOZ" \
      python3 -m voz.fluxo_metricas --parte "$PARTE" ;;
  simulador-fluxo)
    # simulador de texto do Fluxo e roleplay (SQL 58/59), atrás do Caddy (:8443 /simular e /roleplay); desligado por
    # padrão: só com o metadado motorcx-simulador-fluxo=1 (a chave vem do cofre: motorcx-voz-simulador)
    if [ "$(meta motorcx-simulador-fluxo)" != 1 ]; then
      echo "simulador do Fluxo desligado nesta VM (metadado motorcx-simulador-fluxo)"; exit 0
    fi
    exec docker run --name motorcx-voz-simulador-fluxo "${comum_voz[@]}" "$IMG_VOZ" \
      python3 -m voz.simulador_http --porta 8091 --roleplay --provedores /etc/motorcx/provedores.json ;;
  gerar-fluxo)
    # contínuo: pega o próximo pedido em texto (fila do banco, "for update skip locked": as duas VMs podem rodar),
    # gera com o LLM, valida e devolve o rascunho; apaga os anexos vencidos. Nos dois acessos da VM (voz/acesso.py).
    if [ "$(meta motorcx-gerar-fluxo)" != 1 ]; then
      echo "geração de fluxo por texto desligada nesta VM (metadado motorcx-gerar-fluxo)"; exit 0
    fi
    llm=()
    url="$(meta motorcx-gerar-fluxo-base-url)"     # API compatível com OpenAI (padrão: https://api.openai.com/v1)
    if [ -n "$url" ]; then
      [[ "$url" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._/-]*)?$ ]] || { echo "motorcx-gerar-fluxo-base-url inválido" >&2; exit 2; }
      llm+=(--base-url "$url")
    fi
    modelo="$(meta motorcx-gerar-fluxo-modelo)"    # padrão: gpt-4.1
    if [ -n "$modelo" ]; then
      [[ "$modelo" =~ ^[A-Za-z0-9._:/-]{1,80}$ ]] || { echo "motorcx-gerar-fluxo-modelo inválido" >&2; exit 2; }
      llm+=(--modelo "$modelo")
    fi
    exec docker run --name motorcx-voz-gerar-fluxo "${comum_voz[@]}" "$IMG_VOZ" \
      python3 -m voz.gerar_fluxo --intervalo 15 "${llm[@]}" ;;
  gerar-segmentacao)
    # contínuo (SQL 79, "Descrever segmentos e régua"): pega o próximo pedido (fila do banco, "for update skip locked"),
    # gera a proposta com o LLM, compila e valida com o Python do motor e devolve; o banco confirma ou estorna os créditos.
    # Mesma chave do LLM da geração do fluxo (motorcx-voz-llm-fluxo). Nos dois acessos da VM (voz/acesso.py).
    if [ "$(meta motorcx-gerar-segmentacao)" != 1 ]; then
      echo "Descrever segmentos e régua desligado nesta VM (metadado motorcx-gerar-segmentacao)"; exit 0
    fi
    llm=()
    url="$(meta motorcx-gerar-segmentacao-base-url)"     # API compatível com OpenAI (padrão: a mesma da geração do fluxo)
    if [ -n "$url" ]; then
      [[ "$url" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._/-]*)?$ ]] || { echo "motorcx-gerar-segmentacao-base-url inválido" >&2; exit 2; }
      llm+=(--base-url "$url")
    fi
    modelo="$(meta motorcx-gerar-segmentacao-modelo)"    # padrão: o mesmo da geração do fluxo
    if [ -n "$modelo" ]; then
      [[ "$modelo" =~ ^[A-Za-z0-9._:/-]{1,80}$ ]] || { echo "motorcx-gerar-segmentacao-modelo inválido" >&2; exit 2; }
      llm+=(--modelo "$modelo")
    fi
    exec docker run --name motorcx-voz-gerar-segmentacao "${comum_voz[@]}" "$IMG_VOZ" \
      python3 -m voz.gerar_segmentacao --intervalo 10 "${llm[@]}" ;;
  *) echo "uso: motorcx-voz-rodar asterisk|orquestrador|simulado|transcricao|speech|speech-noite|speech-temas|speech-buscas|simulador-fluxo|importador|fluxo-noite|gerar-fluxo|gerar-segmentacao|sons|firewall|teste" >&2; exit 2 ;;
esac
